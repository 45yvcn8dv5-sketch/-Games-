<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chill-Hub</title>
  <style>
    /* Global CSS Variables for Light/Dark Mode */
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --text-color: #f8fafc;
      --subtext-color: #94a3b8;
      --accent-color: #38bdf8;
      --accent-hover: #7dd3fc;
      --border-color: #334155;
    }

    /* Light Theme Overrides */
    [data-theme="light"] {
      --bg-color: #f1f5f9;
      --card-bg: #ffffff;
      --text-color: #0f172a;
      --subtext-color: #475569;
      --accent-color: #0284c7;
      --accent-hover: #0369a1;
      --border-color: #cbd5e1;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header & Navigation */
    header {
      background-color: var(--card-bg);
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .logo-container {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      cursor: pointer;
    }

    .logo-badge {
      width: 45px;
      height: 45px;
      background: linear-gradient(135deg, #38bdf8, #818cf8);
      color: #0f172a;
      font-weight: 800;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
      letter-spacing: 1px;
    }

    .site-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-color);
      letter-spacing: 0.5px;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 1.5rem;
    }

    nav a {
      color: var(--subtext-color);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    nav a:hover {
      color: var(--accent-color);
    }

    /* Theme Toggle Button */
    .theme-btn {
      background-color: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-color);
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .theme-btn:hover {
      border-color: var(--accent-color);
      color: var(--accent-color);
    }

    /* Main Grid Layout */
    main {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      padding: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
    }

    /* Card Component */
    .card {
      background-color: var(--card-bg);
      padding: 2rem;
      border-radius: 16px;
      border: 1px solid var(--border-color);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
    }

    .card h2 {
      font-size: 1.8rem;
      margin-bottom: 1rem;
      color: var(--accent-color);
    }

    .card p {
      color: var(--subtext-color);
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    /* Buttons */
    .btn {
      background-color: var(--accent-color);
      color: #0f172a;
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s, transform 0.1s;
    }

    .btn:hover {
      background-color: var(--accent-hover);
      transform: translateY(-2px);
    }

    .btn:active {
      transform: translateY(0);
    }

    .btn-group {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
    }

    /* Counter Display */
    .counter-display {
      font-size: 3rem;
      font-weight: bold;
      color: var(--text-color);
      margin: 1rem 0;
    }

    /* Footer */
    footer {
      text-align: center;
      padding: 1.5rem;
      background-color: var(--card-bg);
      color: var(--subtext-color);
      font-size: 0.9rem;
      border-top: 1px solid var(--border-color);
    }
  </style>
</head>
<body>

  <!-- Header Section -->
  <header>
    <div class="logo-container" onclick="welcomeAlert()">
      <div class="logo-badge">CH</div>
      <span class="site-title">Chill-Hub</span>
    </div>
    <nav>
      <ul>
        <li><a href="#" onclick="changeGreeting('Welcome back to the Hub!')">Home</a></li>
        <li><a href="#" onclick="changeGreeting('Chill-Hub: Built for relaxing vibes.')">About</a></li>
      </ul>
      <button class="theme-btn" id="themeToggle" onclick="toggleTheme()">🌙 Dark</button>
    </nav>
  </header>

  <!-- Main Content Area -->
  <main>
    
    <!-- Dynamic Welcome Card -->
    <div class="card">
      <div>
        <h2>Status</h2>
        <p id="greetingText">Welcome to Chill-Hub! Explore around and test the controls.</p>
      </div>
      <button class="btn" onclick="sayHello()">Click Me!</button>
    </div>

    <!-- Chill Meter Counter Card -->
    <div class="card">
      <div>
        <h2>Chill Meter</h2>
        <p>Measure your current chill level:</p>
        <div class="counter-display" id="chillCount">0</div>
      </div>
      <div class="btn-group">
        <button class="btn" onclick="adjustChill(-1)">- Less</button>
        <button class="btn" onclick="adjustChill(1)">+ More</button>
      </div>
    </div>

    <!-- Random Quote Generator Card -->
    <div class="card">
      <div>
        <h2>Vibe Check</h2>
        <p id="quoteDisplay">"Take it easy, one step at a time."</p>
      </div>
      <button class="btn" onclick="generateQuote()">New Quote</button>
    </div>

  </main>

  <!-- Footer -->
  <footer>
    &copy; 2026 Chill-Hub. All rights reserved.
  </footer>

  <!-- Interactive JavaScript -->
  <script>
    // 1. Dark/Light Theme Switcher
    let isDark = true;
    function toggleTheme() {
      const body = document.body;
      const themeBtn = document.getElementById('themeToggle');
      
      if (isDark) {
        body.setAttribute('data-theme', 'light');
        themeBtn.textContent = '☀️ Light';
      } else {
        body.removeAttribute('data-theme');
        themeBtn.textContent = '🌙 Dark';
      }
      isDark = !isDark;
    }

    // 2. Interactive Counter (Chill Meter)
    let chillLevel = 0;
    function adjustChill(amount) {
      chillLevel += amount;
      document.getElementById('chillCount').textContent = chillLevel;
    }

    // 3. Dynamic Text Changes
    function changeGreeting(newMessage) {
      document.getElementById('greetingText').textContent = newMessage;
    }

    function sayHello() {
      const responses = [
        "You clicked the button! Stay chill. 😎",
        "Keep grinding, but don't forget to take breaks! ☕",
        "Hope you're having an awesome day! 🚀",
        "Chill-Hub interactivity is working! 🎉"
      ];
      const randomIndex = Math.floor(Math.random() * responses.length);
      document.getElementById('greetingText').textContent = responses[randomIndex];
    }

    function welcomeAlert() {
      alert("CH - Chill-Hub Logo Clicked!");
    }

    // 4. Random Quote Generator
    const quotes = [
      "\"Take it easy, one step at a time.\"",
      "\"Peace comes from within.\"",
      "\"Smooth seas never made a skilled sailor, but smooth vibes make a good day.\"",
      "\"Do what you love, leave the stress behind.\"",
      "\"Breathe in calmness, breathe out tension.\""
    ];

    function generateQuote() {
      const randomIndex = Math.floor(Math.random() * quotes.length);
      document.getElementById('quoteDisplay').textContent = quotes[randomIndex];
    }
  </script>

</body>
</html>
